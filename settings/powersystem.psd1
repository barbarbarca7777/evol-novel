    GrowthStages = @{
        Stage1_Awakening = @{
            Name        = '覚醒'
            Description = '本能的・反射的な発動。レイ・アスカ・シンジにとっては「壁」がそのままの形で発現する段階。第1話のジュンペイもこの段階だが、彼の場合は最初から壁ではなく接続の力として現れる。'
        }
        Stage2_Control = @{
            Name        = '制御'
            Description = '意識的に技を出せるようになる。近い将来のジュンペイの目標として使える。'
        }
        Stage3_Evolution = @{
            Name        = '進化・第二形態'
            Description = '大きなきっかけ(限界状況・覚悟・喪失)で技名ごと進化する段階。卍解・領域展開的な位置づけ。レイ・アスカ・シンジにとっては「壁を自分の意志で作り変える」瞬間として描く(壁をなくすのではなく、拒絶のための壁から、自分と大切な者を守るための壁へと質を変える)。進化後は新しい技名を与える(例: 「臨界解放・暴走」→進化形の仮称は都度検討)。'
        }
        Stage4_Resonance = @{
            Name        = '共鳴覚醒'
            Description = '第4話で仕込んだ「共鳴」(ジュンペイとシンジの初回接触時の反応)を、複数パイロットが同調して底上げする協力技のメカニズムに発展させる。いわゆる友情パワーアップ。ペアはジュンペイ×シンジに限らず、今後レイ・アスカとの組み合わせにも拡張しうる。'
        }
        Stage5_TrueForm = @{
            Name        = '真の力'
            Description = 'シリーズ終盤級の切り札。使用は物語のクライマックス級の場面に限定する。'
