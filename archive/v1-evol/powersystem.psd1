@{
    # 使徒・パイロット双方の「技体系」を統一管理する参照ファイル。
    # ジャンプ的な必殺技・敵デザインの一貫性を保つための中核設定であり、
    # この作品の重要な柱の一つとして扱う。
    #
    # 注意: このファイルは Sync-Settings.ps1 の自動置換の対象外(参照用の設計図)。
    # 使徒の固有名(サキエル等)を実際に本文で使うようになったら、
    # characters.psd1 と同様に FullName 的な扱いで自動置換対象に組み込むことを検討する。

    DeclarationStyleRule = @{
        Description = '必殺技の発動宣言は、技名(エクスカリバー等)を読み上げるだけの単調な羅列にしない。挑発・懇願・覚悟などキャラの個性が乗る一言を必ず添える(例: レイ「ここは通さない」、アスカ「目立つのは私の役目よ」、シンジ「頼む、応えてくれ」)。技名だけを連呼する戦闘描写が続くと、読んでいて単調になるため、複数キャラが同じ話で技を出す場面では特に注意する。'
    }

    CoreRule = @{
        Name        = 'コア(核)'
        Description = '全ての使徒が体内に持つ弱点器官。単なる弱点ではなく、「人間本体と異形の戦闘形態を繋ぐ接点」という意味を持つ。これを破壊すると、使徒の戦闘形態そのものが解除される(=殺すのではなく、纏っている異形を強制解除するイメージ)。倒し方の共通ルールとして、毎回読者に「今回はどこにコアがあるか」を提示する。第1話の個体にも「赤黒い光を灯した核」として既に描写済みで、本文と矛盾しない。'
    }

    AngelMotifRule = @{
        Description = '使徒は聖書由来の天使名をコードネームとして持ち、名前の由来(属性・伝承上の役割)がそのままビジュアル・攻撃属性に直結する。読者が名前だけで強さの方向性を直感できるようにする。'
    }

    HumanityRule = @{
        Description = '使徒は異形の姿を取るが、その正体は常に人間。原理はこちら側の「EVA(適合者が纏う戦闘形態)」と同一で、ゲヘナがそれを兵器として悪用・歪めたものが使徒である――呪術廻戦の呪霊/術式が常に人間(術者)を発生源に持つのと同じ構造。使徒=人間が纏った異形の鎧、という位置づけなので、コアを破壊しても必ずしも人間本体を殺すとは限らない(戦闘形態が解除されるだけ、というケースを後の展開で使える)。序盤(1話〜)は「異形の怪物」としての恐怖・スペクタクルを優先し、いきなり人間性を強調しない。話数が進むにつれて、核の質感・断末魔・輪郭などに少しずつ人間性の手がかりを混ぜていく。中盤以降、仮面を剥がすように「人対人」の対立へ重心を移し、最終的にはそこが物語の熱量の中心になる。1話の個体は正式名を与えず「未識別・モブ」のまま撃退済みとして扱い、遡及的な書き直しはしない。'
    }

    # 使徒ロースター(ストック含む)。登場させる際はここから選び、Design/Statusを更新する。
    ShitoRoster = @{
        Sachiel = @{
            DisplayName = 'サキエル'
            Motif       = '水/衝撃属性。原典では「神の加護」の意。'
            Design      = '黒く濡れた質感の太い触腕、赤黒く脈打つコア。コアの奥に、うっすらと人型のシルエットが透けて見える(今回初めて描写する人間性のきっかけ)。'
            Status      = '未登場(第5話で初のネームド使徒として正式登場予定)。1話の個体とは別の未識別個体で、名前は使い回さない。'
        }
        Shamshael = @{
            DisplayName = 'シャムシエル'
            Motif       = '火属性、機動力特化。原典では「神の焔」の意。'
            Design      = '未確定(ストック)'
            Status      = '未登場'
        }
        Ramiel = @{
            DisplayName = 'ラミエル'
            Motif       = '光線・貫通属性、幾何学的な結晶体シルエット。原典では「神の雷」の意。'
            Design      = '八面体的な幾何学ボディ、圧倒的な遠距離砲撃。中盤の強敵候補。'
            Status      = '未登場'
        }
        Ireul = @{
            DisplayName = 'イロエル'
            Motif       = '微小・侵食・精神干渉タイプ。'
            Design      = '未確定(ストック)'
            Status      = '未登場'
        }
        Matarael = @{
            DisplayName = 'マトリエル'
            Motif       = '酸・腐食タイプ。'
            Design      = '未確定(ストック)'
            Status      = '未登場'
        }
        Sahaquiel = @{
            DisplayName = 'サハクィエル'
            Motif       = '落下・重力タイプ。'
            Design      = '未確定(ストック)'
            Status      = '未登場'
        }
    }

    # パイロットの適性系統。EVAナンバリングと連動する。
    #
    # 【貫通テーマ】ATフィールドは元々「心の壁」のメタファー。レイ・アスカ・シンジの力は、
    # 根っこでは全員「拒絶・防御のための壁」から出発している(系統ごとに壁の出方が違うだけ)。
    # ジュンペイだけが唯一、壁ではなく「繋がるための力」であり、これが分類外である本質的な理由。
    # 各キャラの成長(GrowthStagesのStage3以降)は、この壁をどう自分の意志で作り変えていくか、
    # というドラマとして描く。
    Systems = @{
        Sensory_Defense = @{
            Name        = '感応・防御系'
            Description = '気配感知+絶対防御。零号(レイ)がこの系統。「感情を殺すことで自分を守る壁」がそのまま人格になっている。成長は、この壁を自分の意志で薄くしていく過程として描く。'
        }
        Amplified_Offense = @{
            Name        = '攻撃増幅系'
            Description = '火力特化。弐号(アスカ)がこの系統。「攻め続けることで弱さを見せない壁」。プライドの高さと直結するキャラ付け。成長は、他者に頼ることを覚え、壁の攻撃性を本当の強さに転化していく過程として描く。'
        }
        Uncontrolled_AllType = @{
            Name        = '制御不能な全属性系'
            Description = '膨大だが暴走しやすい。初号(シンジ)がこの系統。「壁を保てず溢れてしまう」タイプで、恐怖・自信のなさが力の暴走に直結する。だからこそ組織に「かけがえのない戦力」であると同時に「制御しきれない不安要素」として扱われる。成長は、繋がり(特にジュンペイとの共鳴)を通じて壁を保てるようになっていく過程として描く。'
        }
        Unclassified = @{
            Name        = '系統不明'
            Description = '既存のどの系統にも当てはまらない。分類外(ジュンペイ)。他の三人の力が根本的に「壁(拒絶・防御)」から出発しているのに対し、ジュンペイの力だけは最初から「壁を壊し、繋がるための力」である――これが分類外である本質的な理由であり、物語全体を貫くテーマそのもの。'
        }
    }

    # 能力の成長・進化フレームワーク。長編を通じて技が育っていくことを前提に設計する。
    # 各段階に到達する具体的なきっかけ・話数は、都度の会議で決める(ここでは骨格のみ規定)。
    GrowthStages = @{
        Stage1_Awakening = @{
            Name        = '覚醒'
            Description = '本能的・反射的な発動。レイ・アスカ・シンジにとっては「壁」がそのままの形で発現する段階。第1話のジュンペイもこの段階だが、彼の場合は最初から壁ではなく接続の力として現れる。'
        }
        Stage2_Control = @{
            Name        = '制御'
            Description = '意識的に技を出せるようになる。近い将来のジュンペイの目標として使える。'
        }
        Stage3_Evolution = @{
            Name        = '進化・第二形態'
            Description = '大きなきっかけ(限界状況・覚悟・喪失)で技名ごと進化する段階。卍解・領域展開的な位置づけ。レイ・アスカ・シンジにとっては「壁を自分の意志で作り変える」瞬間として描く(壁をなくすのではなく、拒絶のための壁から、自分と大切な者を守るための壁へと質を変える)。進化後は新しい技名を与える(例: 「臨界解放・暴走」→進化形の仮称は都度検討)。'
        }
        Stage4_Resonance = @{
            Name        = '共鳴覚醒'
            Description = '第4話で仕込んだ「共鳴」(ジュンペイとシンジの初回接触時の反応)を、複数パイロットが同調して底上げする協力技のメカニズムに発展させる。いわゆる友情パワーアップ。ペアはジュンペイ×シンジに限らず、今後レイ・アスカとの組み合わせにも拡張しうる。'
        }
        Stage5_TrueForm = @{
            Name        = '真の力'
            Description = 'シリーズ終盤級の切り札。使用は物語のクライマックス級の場面に限定する。'
        }
    }
}
