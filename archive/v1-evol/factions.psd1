@{
    # 組織間の対立構造マップ。長編・ジャンプ路線として、敵対・共闘・裏切り・
    # 和解・仲間化を成立させるための骨格。この作品の重要な柱の一つ。
    #
    # 注意: このファイルは Sync-Settings.ps1 の自動置換の対象外(参照用の設計図)。
    # 組織の固有名を本文で使うようになったら、world.psd1 側に正式な OrgName として
    # 登録し直し、自動置換対象に組み込むことを検討する。

    Souseikikan = @{
        DisplayName = '創世機関'
        Role        = '表向きは対使徒防衛組織。ジュンペイたちパイロットが所属する現場組織。'
        Leader      = 'ゲンドウ(碇ゲンドウ)'
        Note        = '名目上はセフィロト機関の傘下だが、ゲンドウ自身は独自の思惑(妻の失踪と関係)を持ち、表向き従いながら裏で独自に動いている。'

        # 【横の広がり】創世機関は第七学区支部だけの組織ではない、という前提。
        # 原作NERVが複数支部(第壱〜第参支部等)を持つ組織であることの翻案。
        # ジャンプでいう「他校」「他部隊」に相当する箱として、今のうちに枠だけ用意しておく。
        # 実際の登場・詳細な人物設定は、必要になったアークの会議で決める。
        Branches = @{
            Branch07 = @{
                DisplayName = '第七学区支部'
                Note        = '本作の舞台。ジュンペイ・シンジ・レイ・アスカが所属する現場拠点。'
            }
            Headquarters = @{
                DisplayName = '本部'
                Note        = '未登場。全支部を統括する中枢で、セフィロト機関との窓口に最も近い。第七学区支部より政治色・階級色が強い方向性を想定。視察/合同任務のきっかけとして使える。'
            }
            OverseasBranch = @{
                DisplayName = '海外支部(仮)'
                Note        = '未登場。アスカの「海外の養成機関出身」という既存設定と接続できる拠点。参号機・四号機など、初号/零号/弐号以外のナンバリング機とその専属パイロットの受け皿になる。'
            }
        }
    }

    Sephiroth = @{
        DisplayName = 'セフィロト機関'
        Role        = '創世機関を裏で操る黒幕組織。ゲンドウの上位に位置する。'
        Leader      = '未設定(中盤で具体化する)'
        Note        = 'ゲンドウとの間に思想の違いによる緊張がある(同一系列組織内の対立)。ゲヘナとの関係性(繋がっているか、真っ向から敵対しているか)は意図的に未確定のまま残し、中盤の会議で「本当の黒幕」を決める。'

        # 【横の広がり】原作SEELEのモノリス(匿名の合議体)をそのまま踏襲せず、
        # 少なくとも1〜2名には個人としての人格・顔を与える方針。カバラのセフィラ名は
        # 一般的な知名度が低いため、ギリシャ神話のティターン(タイタン)神族の名前に変更。
        # 「オリンポスの神々(現在の秩序)より前から存在する古い支配者」という意味合いが、
        # 黒幕組織のイメージとも合う。実際に喋らせる/対決させるのは終盤の黒幕対決が近づいてから。
        Council = @{
            Cronus = @{
                DisplayName = 'クロノス(仮)'
                Note        = '未登場。合議体の中で最も発言力が強い、まとめ役寄りの声を想定。'
            }
            Atlas = @{
                DisplayName = 'アトラス(仮)'
                Note        = '未登場。'
            }
            Rhea = @{
                DisplayName = 'レア(仮)'
                Note        = '未登場。'
            }
        }
    }

    Gehenna = @{
        DisplayName = 'ゲヘナ(仮)'
        Role        = '使徒を生み出す敵対組織。使徒は元人間で、ゲヘナが強制的または志願で人間を使徒化している。創世機関のパイロット技術のダークミラー的存在。'
        Leader      = '未設定'
        Note        = '内部にも路線対立を仕込む想定(使徒化推進派 vs 被害者・脱走派)。ここが「敵組織との和解」「敵陣営からの仲間化」の受け皿になる。第1話で示唆した「使徒の一部が後に仲間になる」という方向性は、ゲヘナからの離反者として実現する想定。'

        # 【横の広がり】ゲヘナ側にも「人間の姿のまま出てくる、名前と個性を持つ幹部」を
        # 用意する(アカツキ/エスパーダ/敵連合に相当)。使徒(天使名)と対になるよう、
        # 堕天使・悪魔の名を codename に使う案。人対人テーマの直接の受け皿。
        Cadre = @{
            Leviathan = @{
                DisplayName = 'レヴィアタン(仮)'
                Note        = '未登場。'
            }
            Belial = @{
                DisplayName = 'ベリアル(仮)'
                Note        = '未登場。'
            }
            Mammon = @{
                DisplayName = 'マモン(仮)'
                Note        = '未登場。'
            }
            Asmodeus = @{
                DisplayName = 'アスモデウス(仮)'
                Note        = '未登場。'
            }
            Beelzebub = @{
                DisplayName = 'ベルゼブブ(仮)'
                Note        = '未登場。'
            }
            # 「ルシファー」は最終盤の黒幕級の名として温存し、幹部枠には含めない。
        }
    }

    ## 今後の会議で決めるべき分岐点(概要段階でのメモ)
    OpenQuestions = @(
        'セフィロトとゲヘナは繋がっているのか、独立して敵対しているのか'
        'ゲヘナ内部の路線対立を、どのタイミングで・どのキャラクターを通じて描くか'
        '創世機関がセフィロトまたはゲヘナの一派と一時的に共闘する展開を、どのアークで使うか'
        '真の最終ボス組織をどこに置くか(セフィロト/ゲヘナ/さらに上の第三勢力)'
        'ジュンペイに能力因子を埋め込んだ実行主体は誰か(セフィロトの独自工作か、ゲヘナの前身勢力か、他の何かか)。ゲンドウ・創世機関の正規プロセスではないことだけは確定している'
        'ジュンペイの両親が過去にエヴァ関連の世界とどう接点を持っていたか(知っていて隠しているのか、記憶を消されているのか等)'
        '創世機関の他拠点(本部/海外支部)を、どのアークでどう登場させるか。合同任務か、対抗戦のような形式か'
        'ゲヘナ幹部(Cadre)を初めて表に出すタイミングと、どの幹部から出すか。誰かをジュンペイの出自と直接結びつけるか'
        'セフィロト評議会(Council)の誰から先に人格を持たせるか。ゲンドウとの対話シーンをどこで作るか'
    )
}
